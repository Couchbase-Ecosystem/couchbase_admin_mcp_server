# Capella container — copy to .env.capella and fill in.
#
#   cp deploy/env.capella.example deploy/.env.capella
#   docker compose --env-file deploy/.env.capella -f deploy/docker-compose.capella.yml up -d
#
# NOTE WHAT IS ABSENT: there is no CB_CONNECTION_STRING here, and adding one
# does not give this container more reach. It resolves the deployment mode to
# 'both', which switches capability gating off and loads every ns_server admin
# tool alongside the Capella ones — against a control plane that will answer
# each of them with an opaque 401. The container refuses to start rather than
# run that way.

# ── Capella ──────────────────────────────────────────────────────────────────

# The organization API key SECRET. This is NOT CAPELLA_ACCESS_KEY_ID — they are
# different values, and the 401 Capella returns for the wrong one blames the IP
# allowlist, which sends you debugging the network instead of the credential.
CAPELLA_API_KEY_SECRET=

# Optional. Discovered from the key if omitted; set it to pin one organization
# when the key can see several.
CB_CAPELLA_ORG_ID=

# ── Posture ──────────────────────────────────────────────────────────────────

CB_ADMIN_PROFILE=enterprise
CB_ADMIN_READ_ONLY_MODE=true
CB_ADMIN_TRANSPORT=http

# 8001 on the host, so this and the EE container can both be up without a port
# clash. They remain separate containers on separate networks.
MCP_CAPELLA_PORT=8001

# ── Corporate TLS interception ───────────────────────────────────────────────
#
# The most likely first failure in a corporate network, and it looks like a
# Capella outage rather than a certificate problem: the v4 control plane is
# reached over HTTPS, a re-signing proxy replaces the certificate, and Python's
# bundled CA set does not trust the replacement.
#
# See env.ee.example for the export command.
CORP_CA_FILE=
CORP_CA_IN_CONTAINER=/etc/ssl/certs/corp-ca.pem
