# Enterprise Edition container — copy to .env.ee and fill in.
#
#   cp deploy/env.ee.example deploy/.env.ee
#   docker compose --env-file deploy/.env.ee -f deploy/docker-compose.ee.yml up -d
#
# Do NOT add CAPELLA_API_KEY_SECRET to this file. A Capella key alongside a
# connection string resolves the deployment mode to 'both', which switches
# capability gating off. The container refuses to start if that happens, which
# is the intended outcome and not a bug to work around.

# ── The cluster ──────────────────────────────────────────────────────────────

# The Docker network your Couchbase containers are already on.
# Find it with:  docker network ls
# or let scripts/run-docker-verification.ps1 discover it.
COUCHBASE_NETWORK=couchbase_default

# By CONTAINER NAME, not localhost and not an IP. On the shared network the
# cluster map's internal addresses are correct, which is the whole reason to
# run here rather than on the host.
CB_CONNECTION_STRING=couchbase://db1

CB_USERNAME=Administrator
CB_PASSWORD=

# ── Posture ──────────────────────────────────────────────────────────────────

CB_ADMIN_PROFILE=enterprise

# Start read-only. Turning writes on is a decision, and every write tool still
# requires confirm:true on top of this.
CB_ADMIN_READ_ONLY_MODE=true

CB_ADMIN_TRANSPORT=http
MCP_EE_PORT=8000

# ── Corporate TLS interception ───────────────────────────────────────────────
#
# The image is python:3.12-slim, and Python trusts its own bundled CA set
# rather than the host machine's store. Where a proxy re-signs outbound TLS,
# the re-signed certificate is untrusted inside the container and every call
# fails in a way that reads like the cluster being down.
#
# Export the roots the machine already trusts, then point these at the file.
# On Windows:
#   $pem = "$env:USERPROFILE\corp-ca.pem"
#   Get-ChildItem Cert:\LocalMachine\Root, Cert:\LocalMachine\CA | ForEach-Object {
#       "-----BEGIN CERTIFICATE-----"
#       [Convert]::ToBase64String($_.RawData, 'InsertLineBreaks')
#       "-----END CERTIFICATE-----" } | Set-Content -Encoding ascii $pem
#
# Leave both blank on a network with no interception.
CORP_CA_FILE=
CORP_CA_IN_CONTAINER=/etc/ssl/certs/corp-ca.pem
