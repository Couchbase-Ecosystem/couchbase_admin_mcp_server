graph TB
  subgraph W["WORKSTATION profile - human present on stdio"]
    W1["Claude Desktop"] -->|stdio| W2["server.py"]
    W4["Operator browser"] -->|"loopback HTTP"| W5["Flask console"]
    W2 --> W3["local cluster / Capella"]
    W5 --> W3
  end
  subgraph E["ENTERPRISE profile - unattended, OAuth"]
    E1["Agent chain"] -->|"streamable_http + OAuth"| E2["server.py in container"]
    E2 -->|"validate JWT"| E3["OIDC provider"]
    E2 --> E4["cluster / Capella"]
    E2 --> E5["durable audit file"]
  end
  style W fill:#eef4fb,stroke:#2c6fb5
  style E fill:#f3e5f5,stroke:#6a1b9a
